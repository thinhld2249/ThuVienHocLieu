# Caddy phục vụ React dist + reverse proxy /api (spec §15.1).
# Site address = http://{$SITE_DOMAIN:localhost}:{$PORT:80} — scheme http://
# bắt buộc HTTP thường, tắt hoàn toàn automatic HTTPS/Let's Encrypt (trên
# Render LB xử lý TLS; port tường minh không đủ — Caddy vẫn xin chứng chỉ).
#   - dev cục bộ: không env → http://localhost:80
#   - 1-VM compose: SITE_DOMAIN=<domain> trần → http://<domain>:80
#   - Render: SITE_DOMAIN=<domain> trần, PORT do Render inject (mặc định 10000)
# API_URL = URL công khai của service api (Render) hoặc api:8080 (compose).
http://{$SITE_DOMAIN:localhost}:{$PORT:80} {
	encode zstd gzip

	@upload path /api/teacher/files /api/teacher/quizzes/import/* /api/teacher/classes/*/students/import
	request_body @upload {
		max_size 60MB
	}

	handle /api/* {
		reverse_proxy {$API_URL:api:8080}
	}

	# health cho monitoring từ ngoài (spec §13) — không proxy thì rơi SPA fallback trả 200 giả
	handle /health/* {
		reverse_proxy {$API_URL:api:8080}
	}

	handle /sitemap.xml {
		reverse_proxy {$API_URL:api:8080}
	}

	# Asset Vite có hash trong tên file → cache 1 năm, không cần revalidate.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	handle /openapi/* {
		reverse_proxy {$API_URL:api:8080}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# frame-src: Google login + video nhúng (YouTube/Vimeo/Drive — khớp allowlist HtmlSanitize BE)
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; frame-src https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://drive.google.com; connect-src 'self' https://accounts.google.com; img-src 'self' data: https://res.cloudinary.com https://lh3.googleusercontent.com; media-src https://res.cloudinary.com; style-src 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; font-src https://fonts.gstatic.com"
	}
}
