# Sao thành deploy/.env và điền giá trị. KHÔNG commit deploy/.env.

# --- Domain & ảnh ---
SITE_DOMAIN=hoclieu.truong.edu.vn
GHCR_ORG=
TAG=latest
VITE_GOOGLE_CLIENT_ID=

# --- Database ---
DB_PASSWORD=
ConnectionStrings__Default=Host=db;Database=hoclieu;Username=hoclieu;Password=
Db__MigrateOnStartup=true

# --- Auth ---
Auth__GoogleClientId=
Auth__AdminEmails=
Auth__AllowedDomains=

# --- Cloudinary ---
Cloudinary__Url=
Cloudinary__Root=hoclieu-prod

# --- Gotenberg ---
Gotenberg__Url=http://gotenberg:3000

# --- Upload ---
Upload__MaxMb=50

# --- Security ---
Security__IpHashSalt=

# --- SMTP (tuỳ chọn — bỏ trống để tắt) ---
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=
